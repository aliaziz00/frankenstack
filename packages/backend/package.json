  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
